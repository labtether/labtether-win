<UserControl
    x:Class="LabTetherAgent.Components.MetricsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:LabTetherAgent.Components"
    IsTabStop="False">
    <!-- CPU, memory and disk on one sheet. -->
    <Border Style="{StaticResource LTSheetStyle}">
        <StackPanel>
            <components:UsageRow x:Name="CpuRow" Label="CPU" />
            <components:UsageRow x:Name="MemoryRow" Label="Memory" />
            <components:UsageRow x:Name="DiskRow" Label="Disk" />
        </StackPanel>
    </Border>
</UserControl>
