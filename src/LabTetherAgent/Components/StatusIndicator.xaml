<UserControl
    x:Class="LabTetherAgent.Components.StatusIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- A status word ("Connected", "Offline"): muted text, or the bad text colour for a problem. -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Problem">
                    <VisualState.Setters>
                        <Setter Target="StatusLabel.Foreground" Value="{ThemeResource LTBadTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="StatusLabel" Style="{StaticResource LTMetaTextStyle}" FontWeight="Medium"
                   Foreground="{ThemeResource LTText2Brush}" TextWrapping="NoWrap" />
    </Grid>
</UserControl>
