<UserControl
    x:Class="LabTetherAgent.Components.SwitchRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- A settings row: label left, the word On or Off, then the switch (text colour, not the accent). -->
    <Grid Style="{StaticResource LTSettingsRowStyle}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LabelText" Style="{StaticResource LTRowLabelStyle}" />
        <TextBlock x:Name="StateText" Grid.Column="1" Style="{StaticResource LTValueWordStyle}"
                   AutomationProperties.AccessibilityView="Raw" />
        <!-- The stock switch keeps a 12 px column for its own On/Off text (this row shows the word on
             the left) and 4 px above and below; the margins trim both so rows stay 36 px. -->
        <ToggleSwitch x:Name="Switch" Grid.Column="2" MinWidth="0" Margin="-4,-4,-12,-4" OnContent="" OffContent=""
                      VerticalAlignment="Center" Toggled="OnToggled" />
    </Grid>
</UserControl>
