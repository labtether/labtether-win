<UserControl
    x:Class="LabTetherAgent.Components.AlertBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- One firing alert: a warning or critical dot, the title, then summary and start time. -->
    <Grid MinHeight="48" Padding="12,5,12,5" ColumnSpacing="8">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Warning" />
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="SeverityDot.Fill" Value="{ThemeResource LTBadBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="SeverityDot" Width="8" Height="8" Margin="0,6,0,0" VerticalAlignment="Top"
                 Fill="{ThemeResource LTWarnBrush}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="NameText" Style="{StaticResource LTBodyTextStyle}" FontWeight="Medium"
                       Foreground="{ThemeResource LTTextBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="MessageText" Style="{StaticResource LTDetailTextStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
