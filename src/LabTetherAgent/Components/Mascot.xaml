<UserControl
    x:Class="LabTetherAgent.Components.Mascot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">
    <!--
      The LabTether mascot, drawn as hub/web/console/app/icon.svg (32 x 32). Brand
      art: its colours and faint body gradient are fixed and do not follow the theme.
    -->

    <Viewbox Stretch="Uniform">
        <Canvas Width="32" Height="32">
            <Rectangle Width="32" Height="32" RadiusX="7" RadiusY="7">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#FFFDFCF8" />
                        <GradientStop Offset="1" Color="#FFDCD5C7" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Canvas.Left="0.5" Canvas.Top="0.5" Width="31" Height="31" RadiusX="6.5" RadiusY="6.5"
                       Stroke="#808C8577" StrokeThickness="1" />
            <Rectangle Canvas.Left="5" Canvas.Top="6" Width="22" Height="16" RadiusX="3" RadiusY="3" Fill="#FF0A0A0A" />
            <Rectangle Canvas.Left="6" Canvas.Top="7" Width="20" Height="14" RadiusX="2" RadiusY="2" Fill="#FF1A0012" />
            <Path Data="M11,13 Q13,10 15,13 M17,13 Q19,10 21,13" Stroke="#FFFF79C6" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path Data="M13.5,16.5 Q16,19 18.5,16.5" Stroke="#FFFF79C6" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Rectangle Canvas.Left="6" Canvas.Top="25" Width="8" Height="2" RadiusX="1" RadiusY="1" Fill="#FF8C8577" />
            <Ellipse Canvas.Left="15" Canvas.Top="25" Width="2" Height="2" Fill="#FF00FFCC" />
            <Ellipse Canvas.Left="22" Canvas.Top="24" Width="4" Height="4" Fill="#FFA82B2B" />
            <Ellipse Canvas.Left="23" Canvas.Top="24.5" Width="2" Height="2" Fill="#CCFF6B6B" />
        </Canvas>
    </Viewbox>
</UserControl>
