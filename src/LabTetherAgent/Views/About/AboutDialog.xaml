<ContentDialog
    x:Class="LabTetherAgent.Views.About.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:LabTetherAgent.Components"
    Title="About LabTether Agent"
    PrimaryButtonText="Export diagnostics"
    PrimaryButtonClick="OnPrimaryButtonClick"
    CloseButtonText="Close"
    DefaultButton="None">

    <!-- Mascot, versions and Hub as label-left rows, then links. No main action, so no rose button. -->
    <StackPanel Spacing="16" MinWidth="340">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <components:Mascot Width="48" Height="48" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="LabTether Agent" Style="{StaticResource LTHeadTextStyle}"
                           Foreground="{ThemeResource LTTextBrush}" />
                <TextBlock x:Name="VersionText" Style="{StaticResource LTDetailTextStyle}" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource LTSheetStyle}" Padding="12,8">
            <Grid RowSpacing="8" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="App version" Style="{StaticResource LTMetaTextStyle}" Foreground="{ThemeResource LTText2Brush}" />
                <TextBlock Grid.Column="1" x:Name="AppVersionText" Style="{StaticResource LTMetaTextStyle}"
                           Foreground="{ThemeResource LTTextBrush}" IsTextSelectionEnabled="True" />
                <TextBlock Grid.Row="1" Text="Agent version" Style="{StaticResource LTMetaTextStyle}"
                           Foreground="{ThemeResource LTText2Brush}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AgentVersionText" Style="{StaticResource LTMetaTextStyle}"
                           Foreground="{ThemeResource LTTextBrush}" IsTextSelectionEnabled="True" />
                <TextBlock Grid.Row="2" Text="Hub" Style="{StaticResource LTMetaTextStyle}" Foreground="{ThemeResource LTText2Brush}" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HubUrlText" Style="{StaticResource LTMetaTextStyle}"
                           Foreground="{ThemeResource LTTextBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                <TextBlock Grid.Row="3" Text="Fingerprint" Style="{StaticResource LTMetaTextStyle}"
                           Foreground="{ThemeResource LTText2Brush}" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FingerprintText" FontFamily="{StaticResource LTMonoFontFamily}"
                           FontSize="12" Foreground="{ThemeResource LTTextBrush}" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="16">
            <HyperlinkButton Content="Website" NavigateUri="https://labtether.com" />
            <HyperlinkButton Content="Documentation" NavigateUri="https://labtether.com/docs" />
        </StackPanel>

        <TextBlock x:Name="ExportStatus" Style="{StaticResource LTDetailTextStyle}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
        <TextBlock x:Name="ExportError" Style="{StaticResource LTProblemTextStyle}"
                   AutomationProperties.LiveSetting="Assertive" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
