<Window
    x:Class="LabTetherAgent.Views.Onboarding.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:LabTetherAgent.Components"
    xmlns:shared="using:LabTetherAgent.Views.Shared"
    Title="LabTether Agent setup">

    <!-- One screen: Hub, trust and token on one sheet; device and group ID under Advanced. -->
    <Grid x:Name="Root" Background="{ThemeResource LTCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <components:WindowTitleBar x:Name="TitleBar" Title="LabTether Agent setup" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32,28,32,24">
                <components:Mascot Width="48" Height="48" HorizontalAlignment="Left" />
                <TextBlock Text="Set up LabTether Agent" Margin="0,16,0,0" Style="{StaticResource LTTitleTextStyle}"
                           Foreground="{ThemeResource LTTextBrush}" AutomationProperties.HeadingLevel="Level1" />

                <Border Margin="0,24,0,0" Padding="20" Style="{StaticResource LTSheetStyle}">
                    <StackPanel>
                        <TextBlock x:Name="HubUrlLabel" Text="Hub URL" Style="{StaticResource LTFieldLabelStyle}" />
                        <TextBox x:Name="HubUrlInput" PlaceholderText="https://hub.example.com"
                                 AutomationProperties.Name="Hub URL" AutomationProperties.AutomationId="HubUrlBox"
                                 Text="{x:Bind ViewModel.HubUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{x:Bind ViewModel.HubUrlError, Mode=OneWay}" Margin="0,6,0,0"
                                   Style="{StaticResource LTProblemTextStyle}" AutomationProperties.LiveSetting="Polite"
                                   Visibility="{x:Bind shared:Ui.ShowText(ViewModel.HubUrlError), Mode=OneWay}" />

                        <TextBlock Margin="0,16,0,6" Style="{StaticResource LTFieldLabelStyle}">
                            <Run Text="CA certificate file" />
                            <Run Text="(optional)" FontWeight="Normal" Foreground="{ThemeResource LTText3Brush}" />
                        </TextBlock>
                        <TextBox Style="{StaticResource LTMonoTextBoxStyle}" PlaceholderText="C:\path\to\hub-ca.pem"
                                 AutomationProperties.Name="CA certificate file (optional)"
                                 AutomationProperties.AutomationId="CaFileBox"
                                 Text="{x:Bind ViewModel.TlsCaFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Skip certificate check" Margin="0,12,0,0"
                                  AutomationProperties.AutomationId="SkipCertificateCheckBox"
                                  IsChecked="{x:Bind ViewModel.TlsSkipVerify, Mode=TwoWay}" />

                        <TextBlock x:Name="TokenLabel" Text="Token" Margin="0,20,0,6" Style="{StaticResource LTFieldLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="24"
                                    AutomationProperties.Name="Token type">
                            <RadioButton Content="Enrollment token" GroupName="TokenType" MinWidth="0"
                                         AutomationProperties.AutomationId="EnrollmentTokenOption"
                                         IsChecked="{x:Bind ViewModel.UseEnrollmentToken, Mode=TwoWay}" />
                            <RadioButton Content="API token" GroupName="TokenType" MinWidth="0"
                                         AutomationProperties.AutomationId="ApiTokenOption"
                                         IsChecked="{x:Bind ViewModel.UseApiToken, Mode=TwoWay}" />
                        </StackPanel>
                        <PasswordBox Margin="0,10,0,0" PlaceholderText="Paste token"
                                     AutomationProperties.Name="Token" AutomationProperties.AutomationId="TokenBox"
                                     Password="{x:Bind ViewModel.Token, Mode=TwoWay}" />

                        <StackPanel Margin="0,12,0,0" Spacing="8"
                                    Visibility="{x:Bind ViewModel.HasConnectionError, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ConnectionError, Mode=OneWay}"
                                       Style="{StaticResource LTProblemTextStyle}" AutomationProperties.LiveSetting="Assertive" />
                            <Button Content="View logs" AutomationProperties.AutomationId="ViewLogsButton" Click="OnViewLogs" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Expander x:Name="AdvancedExpander" Margin="0,12,0,0" HorizontalAlignment="Stretch" CornerRadius="12"
                          HorizontalContentAlignment="Stretch" AutomationProperties.Name="Advanced"
                          AutomationProperties.AutomationId="AdvancedExpander">
                    <Expander.Header>
                        <StackPanel Padding="0,9">
                            <TextBlock Text="Advanced" Style="{StaticResource LTBodyTextStyle}" FontWeight="Medium"
                                       Foreground="{ThemeResource LTTextBrush}" />
                            <TextBlock Text="Device ID and group ID" Style="{StaticResource LTDetailTextStyle}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="Device ID" Style="{StaticResource LTFieldLabelStyle}" />
                        <TextBox AutomationProperties.Name="Device ID" AutomationProperties.AutomationId="DeviceIdBox"
                                 Text="{x:Bind ViewModel.AssetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Group ID" Margin="0,16,0,6" Style="{StaticResource LTFieldLabelStyle}" />
                        <TextBox PlaceholderText="None" AutomationProperties.Name="Group ID"
                                 AutomationProperties.AutomationId="GroupIdBox"
                                 IsEnabled="{x:Bind ViewModel.CanSetGroupId, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.GroupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource LTFooterStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}" Width="16" Height="16"
                                  Foreground="{ThemeResource LTText2Brush}" />
                    <TextBlock Text="{x:Bind ViewModel.ConnectingText, Mode=OneWay}" Style="{StaticResource LTDetailTextStyle}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource LTFooterButtonStyle}"
                        AutomationProperties.AutomationId="CancelButton" Click="OnCancel" />
                <Button Grid.Column="2" Content="Connect" Style="{StaticResource LTPrimaryButtonStyle}"
                        AutomationProperties.AutomationId="ConnectButton"
                        Command="{x:Bind ViewModel.ConnectCommand}"
                        IsEnabled="{x:Bind ViewModel.CanConnect, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Window>
