<Page
    x:Class="LabTetherAgent.Views.Onboarding.HubUrlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" Padding="0,0,8,16">
        <TextBlock Text="Step 1: Hub URL" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Enter the URL of your LabTether hub."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <TextBox x:Name="HubUrlInput"
                 Header="Hub URL"
                 PlaceholderText="https://hub.example.com"
                 Text="{x:Bind ViewModel.HubUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <InfoBar x:Name="ValidationInfo"
                 IsOpen="{x:Bind ViewModel.HubUrlError, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error"
                 Title="Invalid URL"
                 Message="{x:Bind ViewModel.HubUrlError, Mode=OneWay}" />

        <CheckBox Content="Trust self-signed certificate (homelab only)"
                  IsChecked="{x:Bind ViewModel.TlsSkipVerify, Mode=TwoWay}" />
        <TextBox Header="Custom CA certificate (optional)"
                 PlaceholderText="C:\path\to\labtether-ca.crt"
                 Text="{x:Bind ViewModel.TlsCaFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Use a CA file to keep certificate verification enabled. Skip verification only for temporary development use."
                   FontSize="11" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
    </ScrollViewer>
</Page>
