<Window
    x:Class="LabTetherAgent.Views.TrayIcon.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:LabTetherAgent.Components"
    xmlns:presentation="using:LabTetherAgent.Presentation"
    xmlns:shared="using:LabTetherAgent.Views.Shared"
    Title="LabTether Agent">

    <!-- Borderless panel above the tray: header, problems first, usage, actions. -->
    <Grid x:Name="Root" Background="{ThemeResource LTCanvasBrush}">
        <StackPanel x:Name="FlyoutPanel" Padding="16" Spacing="16" VerticalAlignment="Top">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <components:Mascot Width="28" Height="28" Margin="0,5,0,0" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="LabTether Agent" Style="{StaticResource LTBodyTextStyle}" FontWeight="SemiBold"
                               Foreground="{ThemeResource LTTextBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" Style="{StaticResource LTDetailTextStyle}"
                               Visibility="{x:Bind shared:Ui.Hide(ViewModel.IsProblem), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" Style="{StaticResource LTProblemTextStyle}"
                               Visibility="{x:Bind ViewModel.IsProblem, Mode=OneWay}" />
                </StackPanel>
                <components:StatusIndicator Grid.Column="2" Margin="0,1,0,0" VerticalAlignment="Top"
                                            StatusText="{x:Bind ViewModel.StatusWord, Mode=OneWay}"
                                            IsProblem="{x:Bind ViewModel.IsProblem, Mode=OneWay}" />
            </Grid>

            <StackPanel Spacing="12">
                <Border Style="{StaticResource LTSheetStyle}" Visibility="{x:Bind ViewModel.HasAlerts, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Alerts, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="presentation:AlertRow">
                                <components:AlertBadge AlertName="{x:Bind Title}" Message="{x:Bind Detail}"
                                                       IsCritical="{x:Bind IsCritical}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
                <components:MetricsCard CpuPercent="{x:Bind ViewModel.CpuPercent, Mode=OneWay}"
                                        MemoryPercent="{x:Bind ViewModel.MemoryPercent, Mode=OneWay}"
                                        DiskPercent="{x:Bind ViewModel.DiskPercent, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Open console" Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="OpenConsoleButton"
                        Command="{x:Bind ViewModel.OpenConsoleCommand}" />
                <Button Content="Logs" AutomationProperties.AutomationId="LogsButton" Click="OnOpenLogs" />
                <Button Content="Pop out" AutomationProperties.AutomationId="PopOutButton" Click="OnPopOut" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
