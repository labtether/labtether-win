<Window
    x:Class="LabTetherAgent.Views.LogViewer.LogViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:LabTetherAgent.Components"
    xmlns:state="using:LabTetherAgent.State"
    Title="LabTether Agent logs">

    <!-- Search and level filter, the log on one sheet in Cascadia Mono, then the count and Auto-scroll. -->
    <Grid x:Name="Root" Background="{ThemeResource LTCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <components:WindowTitleBar x:Name="TitleBar" Title="LabTether Agent logs" />

        <Grid Grid.Row="1" Padding="16,4,16,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox PlaceholderText="Search logs" AutomationProperties.Name="Search logs"
                     Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1" Width="120" AutomationProperties.Name="Level"
                      SelectedItem="{x:Bind ViewModel.SelectedLevel, Mode=TwoWay}"
                      ItemsSource="{x:Bind ViewModel.LevelOptions}" />
            <Button Grid.Column="2" Content="Export" Click="OnExport" />
            <Button Grid.Column="3" Content="Clear" Command="{x:Bind ViewModel.ClearCommand}" />
        </Grid>

        <Border Grid.Row="2" Margin="16,0" Padding="4" Style="{StaticResource LTSheetStyle}">
            <ListView x:Name="LogList" ItemsSource="{x:Bind ViewModel.FilteredLines, Mode=OneWay}"
                      SelectionMode="Extended" AutomationProperties.Name="Log lines">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="24" />
                        <Setter Property="Padding" Value="8,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="state:LogLine">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Timestamp}" FontFamily="{StaticResource LTMonoFontFamily}" FontSize="12"
                                       Foreground="{ThemeResource LTText3Brush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Level}" FontFamily="{StaticResource LTMonoFontFamily}"
                                       FontSize="12" Foreground="{ThemeResource LTText2Brush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Message}" FontFamily="{StaticResource LTMonoFontFamily}"
                                       FontSize="12" Foreground="{ThemeResource LTTextBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="3" Padding="16,8,16,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource LTDetailTextStyle}" VerticalAlignment="Center">
                <Run Text="{x:Bind ViewModel.FilteredCount, Mode=OneWay}" />
                <Run Text="of" />
                <Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" />
                <Run Text="lines" />
            </TextBlock>
            <TextBlock x:Name="ExportStatus" Grid.Column="1" Style="{StaticResource LTDetailTextStyle}"
                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ExportError" Grid.Column="1" Style="{StaticResource LTProblemTextStyle}"
                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
            <CheckBox Grid.Column="2" Content="Auto-scroll" MinWidth="0"
                      IsChecked="{x:Bind ViewModel.AutoScroll, Mode=TwoWay}" />
        </Grid>
    </Grid>
</Window>
