<Window
    x:Class="LabTetherAgent.Views.PopOut.PopOutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:LabTetherAgent.Components"
    xmlns:shared="using:LabTetherAgent.Views.Shared"
    Title="LabTether Agent">

    <!-- Always-on-top status and usage, the flyout's content without the actions. -->
    <Grid x:Name="Root" Background="{ThemeResource LTCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <components:WindowTitleBar x:Name="TitleBar" Title="LabTether Agent" />
        <StackPanel Grid.Row="1" Padding="16,4,16,16" Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" Style="{StaticResource LTDetailTextStyle}"
                           Visibility="{x:Bind shared:Ui.Hide(ViewModel.IsProblem), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" Style="{StaticResource LTProblemTextStyle}"
                           Visibility="{x:Bind ViewModel.IsProblem, Mode=OneWay}" />
                <components:StatusIndicator Grid.Column="1"
                                            StatusText="{x:Bind ViewModel.StatusWord, Mode=OneWay}"
                                            IsProblem="{x:Bind ViewModel.IsProblem, Mode=OneWay}" />
            </Grid>
            <components:MetricsCard CpuPercent="{x:Bind ViewModel.CpuPercent, Mode=OneWay}"
                                    MemoryPercent="{x:Bind ViewModel.MemoryPercent, Mode=OneWay}"
                                    DiskPercent="{x:Bind ViewModel.DiskPercent, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Window>
